# Copy to `.env` and fill in. Never commit `.env` and never prefix these with
# VITE_ — anything VITE_* is inlined into the browser bundle.

# Enables AI exam extraction (optional). Without it the app still imports
# JSON/Markdown exams on-device and /api/generate-exam returns 503.
GEMINI_API_KEY=

# Optional: comma-separated browser origins allowed to call /api/*.
# Leave empty in production behind the same domain (the app uses relative URLs).
CORS_ORIGIN=

# Optional: server port (default 3000).
PORT=
